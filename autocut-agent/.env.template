# AutoCut-Agent Environment Variables
# Copy this file to .env and update with your values

# API Configuration
API_SECRET_KEY=change-this-in-production-use-strong-random-key

# Database Configuration (optional, defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/autocut
# DATABASE_URL=sqlite:///data/agent.db

# Redis Configuration (optional, for distributed features)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-redis-password

# LLM API Keys (optional, for LLM features)
# OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# SMTP Configuration (optional, for email alerts)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Agent Configuration Overrides (optional)
# AGENT_LOG_LEVEL=INFO
# AGENT_WORKERS=4
# AGENT_API_HOST=0.0.0.0
# AGENT_API_PORT=8080

# Development Settings (optional)
# AGENT_DEBUG=false
# AGENT_DEV_MODE=false
